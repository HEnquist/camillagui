  test("numberValue returns undefined, if parent property is absent", () => {
    const shortcut = {
      name: "dummy",
      range_from: -5,
      range_to: 5,
      step: 0.5,
      type: "number",
      config_elements: [
        {
          path: ["a", "b"],
