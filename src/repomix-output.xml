            tooltip="Use polling instead of event driven mode"
            onChange={(polling) =>
              onChange((devices) => {
                if (devices.capture.type === "Wasapi") {
                  devices.capture.polling = polling
                }
              })
            }
          />
          <OptionalBoolOption
            value={capture.loopback}
            error={errors.messageFor("loopback")}
            desc="loopback"
