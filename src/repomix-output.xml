body {
  color: var(--text-color);
  background-color: var(--background-color);
  margin: 0;
  height: 100vh;
  width: 100vw;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
    sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-size:1.2em;
transform: scale(0.5);
width: 200%;
height: 200%;
transform-origin: 0 0;
}

hr {
  margin: 3px 0;
  border: 1px solid var(--box-border-color);
}

code {
  font-family: source-code-pro, Menlo, Monaco, Consolas, 'Courier New',
    monospace;
}

input:not([type='checkbox']), select {
  color: var(--text-color);
  background-color: var(--background-color);
  box-sizing: border-box;
  border-radius: var(--border-radius);
  border: var(--input-border);
  height: 28px;
  padding: 0 4px;
  font-size: 1em;
  text-align: center;
}

input:not([type='checkbox']):focus, select:focus {
  border: var(--focused-input-border);
  outline: none;
}

input[type='range'] {
  background-color: transparent;
}

input[type='checkbox'] {
  cursor: pointer;
}

textarea {
  color: var(--text-color);
  background-color: var(--background-color);
}

textarea.logfileviewer {
  resize: none;
  accent-color: var(--background-color);
}

.react-tabs__tab--selected {
  color: var(--text-color);
  background: var(--background-color);
  border: var(--box-border);
  border-bottom: none;
  bottom: calc(-1 * var(--box-border-width));
  border-radius: var(--border-radius) var(--border-radius) 0 0;
}

.react-tabs__tab--selected:after { /* Removes the white bar below selected tab headers */
  visibility: hidden;
}

.react-tabs__tab-list {
  border-bottom: var(--box-border);
}

.unselectable {
  -moz-user-select: none;
  -webkit-user-select: none;
  -ms-user-select: none;
  user-select: none;
}

.checkbox-area {
  cursor: pointer;
  display: inline-block;
  padding: 2px;
}

.sidepanel {
  border: 4px;
  text-align: left;
  padding: 10px 10px 0 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  overflow-y: auto;
  overflow-x: hidden;
/*  height: 95vh; */
  width: 320px;
  min-width: 320px;
}

.tabpanel {
  border: 4px;
  /*border-right: var(--box-border);*/
  text-align: left;
  padding: 10px 20px 0 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 450px;
  /*overflow: auto;*/
  height: 90vh;
}

.tabcontainer {
  width: 100%;
  /* overflow-y: auto; */
}

.tabspacer {
  width: 100%;
}

.tabpanel-with-header {
  border: 4px;
  /*border-right: var(--box-border);*/
  text-align: left;
  padding: 10px 20px 0 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 450px;
  /*overflow: auto;*/
  height: 86vh;
}

.wide-tabpanel {
  border: 4px;
  /*border-right: var(--box-border);*/
  text-align: left;
  padding: 10px 20px 0 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 550px;
  /*overflow: auto;*/
  height: 90vh;
}

.tabpanel > * {
  margin: 5px 0;
}

.configapp {
  padding: 5px;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.configapp > :last-child {
  margin-left: 10px;
}

.configtabs {
  float: left;
  text-align: left;
  padding: 2px;
  display: flex;
  width: 100%;
  min-width: 800px;
  flex-direction: column;
}

.setting {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 28px;
  text-align: left;
}

.setting-input {
  display: block;
  flex-grow: 1;
  width: auto;
  min-width: 50px;
  vertical-align: middle;
}

.setting-label-wide {
  display: table-cell;
  width: 75%;
  text-align: right;
  border-right: 5px solid transparent;
}

.setting-input {
  display: block;
  width: 100%;
  vertical-align: middle;
}

.setting-button {
  vertical-align: middle;
}

.textbox {
  display: table-cell;
  width: 100%;
  vertical-align: middle;
}

.textbox-large {
  display: table-cell;
  width: 100%;
  vertical-align: middle;
}

.setting-input-default {
  display: table-cell;
  width: 100%;
  vertical-align: middle;
  color: var(--disabled-text-color);
}

.small-setting-input {
  width: 5em;
}

.optional-setting-input {
  display: table-cell;
  width: 67%;
  vertical-align: middle;
}

.small-optinal-setting-input {
  width: 4em;
}

.box {
  box-sizing: border-box;
  width: 100%;
  border-radius: var(--border-radius);
  border: var(--box-border);
  padding: 5px 12px 12px 12px;
  background-color: var(--button-background-color);
}

div .popup-content {
  width: 50%;
  background-color: var(--background-color);
  border: var(--box-border);
  border-radius: var(--border-radius);
}

.dropdown {
  position: relative;
}

.dropdown .dropdown-menu {
  position: absolute;
  background-color: var(--background-color);
  border: var(--highlighted-button-border);
  border-radius: var(--border-radius);
  z-index: 1;
  top: 100%;
  left: 0%;
}


@media (max-width: 1023px) {
  div .popup-content {
    width: 80%;
  }
}

.horizontally-spaced-content {
  display: flex;
  flex-direction: row;
  gap: 5px;
}



.vertically-spaced-content {
  display: flex;
  flex-direction: column;
  gap: 5px;
}


.centered-content {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 5px;
}

.diff-table {
  border-collapse: collapse;
  min-width: 30vw;
}

.diff-table > td {
  border: var(--box-border);
  border-collapse: collapse;
}

.diff-cell {
  text-align: left;
  border: var(--box-border);
  border-collapse: collapse;
  padding: 5px;
}

.diff-filename {
  text-align: center;
  border-collapse: collapse;
  padding: 5px;
}

.diff-section-header {
  text-align: left;
  border-collapse: collapse;
  font-weight: bold;
  padding: 20px 5px 5px 5px;
}

.diff-comment {
  text-align: center;
  border-collapse: collapse;
  padding: 5px 5px 5px 5px;
}

.mixer-table {
  border-collapse: collapse;
}

.mixer-table > td {
  border: var(--box-border);
  border-collapse: collapse;
}

.matrix-cell {
  text-align: center;
  border: var(--box-border);
  border-collapse: collapse;
}

.centered {
  text-align: center;
}

.centered-button {
  text-align: center;
  cursor: pointer;
  user-select: none;
}

.centered-button-disabled {
  text-align: center;
  user-select: none;
  color: var(--disabled-text-color);
}

.vertical-matrix-cell2 {
  writing-mode: vertical-rl;
  text-orientation: mixed;
  transform: rotate(180deg);
}
.vertical-matrix-cell {
  text-align: center;
  display: block;
  transform: rotate(270deg);
}

.mapping-cell {
  width: 25px;
  height: 25px;
  line-height: 25px;
  color: black;
  font-size: small;
  text-align: center;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  user-select: none;
}

.mapping-cell-empty {
  width: 25px;
  height: 25px;
  line-height: 25px;
  color: var(--text-color);
  font-size: small;
  text-align: center;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  user-select: none;
}

.strikediag {
  background: linear-gradient(to left top, transparent 47.75%, currentColor 49.5%, currentColor 50.5%, transparent 52.25%);
}

.rotate {
  text-align: center;
  white-space: nowrap;
  vertical-align: middle;
  width: 1.5em;
}
.rotate div {
  writing-mode:vertical-lr;
  transform: rotate(180deg);
}

.two-column-grid {
  display: grid;
  grid-column-gap: 5px;
  grid-row-gap: 2px;
  grid-template-columns: auto auto;
}

.two-column-grid .alignRight {
  justify-self: right;
}

.split-10-90 {
  width: 100%;
  display: grid;
  grid-template-columns: 10% 90%;
  grid-gap: 5px;
}

.split-10-90 > * {
  align-self: center;
}

.button {
  color: var(--button-text-color);
  text-decoration: none;
  box-sizing: border-box;
  background-color: var(--button-background-color);
  border-radius: var(--border-radius);
  border: var(--button-border);
  font-size: smaller;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  user-select: none;
}

.file-link {
  color: var(--link-color);
  text-decoration: none;
  user-select: none;
  font-weight: bold;
}

.button-with-text {
  padding: 3px 6px;
}

.bypass-toggle-button {
  display: inline-grid;
  place-items: center;
  white-space: nowrap;
}

.bypass-toggle-button .button-text {
  grid-area: 1 / 1;
}

.bypass-toggle-button::after {
  content: "Bypassed";
  grid-area: 1 / 1;
  font-style: italic;
  visibility: hidden;
}

.bypass-toggle-button-bypassed {
  font-style: italic;
}

.button-with-icon {
  width: 36px;
  height: 36px;
  color: var(--button-icon-color);
  scale: 1;
}

.smallbutton {
  padding: 1px 3px;
  height: 28px;
  width: 32px;
}

.tinybutton {
  padding: 1px 3px;
  width: unset;
  height: unset;
}

/* Disable hover for mobile/tablets */
@media (hover: hover) and (pointer: fine) {
  .button:hover {
    background-color: var(--hovered-button-background-color);
    border: var(--hovered-button-border);
  }
}

.button:active {
  background-color: var(--active-button-background-color);
  border: var(--active-button-border)
}

.disabled-button, .disabled-button:hover, .disabled-button:active {
  background-color: var(--disabled-button-background-color);
  opacity: var(--disabled-button-opacity);
  cursor: default;
}

.highlighted-button, .highlighted-button:hover, .highlighted-button:active {
  background-color: var(--highlighted-button-background-color);
  border: var(--highlighted-button-border);
}

.config-status {
  margin: 10px 4px 2px;
}

.db-label {
  font-size: 14pt;
  font-family: monospace;
  display: inline-block;
  width: 7ch;
  text-align: right;
  margin-left: 0px;
}

.db-label-muted {
  font-size: 14pt;
  font-family: monospace;
  display: inline-block;
  width: 7ch;
  text-align: right;
  margin-left: 0px;
  color: var(--neutral-text-color);
  font-style: italic;
}

.versions {
  width: 100%;
  margin: 15px 0;
  display: flex;
  flex-direction: row;
  justify-content: center;
  font-size: small;
}

.namecol {
  text-align: left;
}

.valuecol {
  text-align: right;
}


.quick-config-switch > * {
  margin: 5px;
}

.success-text {
  color: var(--success-text-color);
}

.error-text {
  color: var(--error-text-color);
}

.pipeline-channel {
  width: 100%;
  text-align: center;
}

.drag-handle {
  cursor: move;
  outline: transparent;
}

.dragSource {
  opacity: 0.5;
  z-index: 10;
}

.dropTargetParent {
  position: relative;
}

.dropTarget:after {
  content: '';
  display: block;
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  border-radius: var(--border-radius);
  border: var(--highlighted-button-border);
}

.vertical-text {
  transform: rotate(270deg);
  transform-origin: center;
  text-align: center;
}

.eqslider {
  width: 200px;
  height: 30px;
  transform: rotate(-90deg);
  transform-origin: left;
  position: absolute;
  left: 50%;
  bottom: -5%;
}

.eqslider-wrapper {
  display: inline-block;
  width: 30px;
  height: 200px;
  position: relative;
  padding: 5px 5px;
}

.import-tab-tooltip {
  font-family: source-code-pro, Menlo, Monaco, Consolas, 'Courier New', monospace;
  opacity: 1 !important;
  font-size: smaller;
  z-index: 1000;
  display:none;
}

.tooltip {
  opacity: 1 !important;
  text-align: center;
  z-index: 1000;
}

.pipeline-tooltip {
  font-family: source-code-pro, Menlo, Monaco, Consolas, 'Courier New', monospace;
  background-color: var(--background-color);
  white-space: pre;
  font-size: smaller;
  border-radius: var(--border-radius);
  padding: 5px 5px;
}

.channel-indicator {
  width: 4px;
  height: 12px;
  margin-right: 1px;
  margin-left: 1px;
}

.channel-indicator-field {
  display: flex;
  flex-direction: row;
  margin-right: 4px;
  margin-left: 2px;
  vertical-align: middle;
}




/* ===== Стили для оптимизации стандартного блока фильтра ===== */

/* --- 1. Основной контейнер FilterView --- */
.filter-view-container {
    display: flex;
    flex-direction: column; /* Располагаем контент и кнопки друг под другом */
    gap: 8px; /* Расстояние между блоками */
    width: 100%; /* Занимает всю ширину родителя (например, .additional-filter-item) */
}

/* --- 2. Контейнер для параметров (Type, Subtype, freq, Q и т.д.) --- */
.filter-params-container {
    display: flex;
    flex-direction: column;
    gap: 5px; /* Расстояние между полями ввода */
    width: 100%;
}

/* --- 3. Контейнер для кнопок управления (График, Удалить и т.д.) --- */
.filter-controls-container {
    display: flex;
    flex-direction: row; /* Кнопки в ряд */
    justify-content: flex-end; /* Прижимаем кнопки к правому краю */
    gap: 5px;
    padding-top: 5px;
    border-top: var(--box-border); /* Линия-разделитель над кнопками */
    width: 100%;
}

/* --- 4. Адаптация полей ввода для узкого блока --- */
/* Этот класс мы будем использовать для фильтров в горизонтальном ряду */
.narrow-filter-view .setting {
    display: flex;
    flex-direction: column; /* Лейбл над полем ввода */
    align-items: flex-start;
    height: auto; /* Высота автоматическая */
    gap: 2px;
}

.narrow-filter-view .setting-label {
    width: 100%;
    text-align: left; /* Лейбл слева */
    font-size: 0.8em;
    color: var(--disabled-text-color);
    border-right: none;
}

.narrow-filter-view .setting-input {
    width: 100%;
}

/* Добавляем имена для безымянных контейнеров */
.horizontally-spaced-content {
    /* Уже существует, просто для справки */
}
.vertically-spaced-content {
    /* Уже существует, просто для справки */
}




.sidepanel img {
    height: auto;
}


/* ===== Стили для нового многоканального интерфейса (Версия 2) ===== */

/* --- 1. Контейнер для всех контрол-табов --- */
.channel-tabs-container {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;

}

/* --- 2. Стиль для одного контрол-таба --- */
.channel-tab-button {
    background-color: #141d25;
    /*border: var(--button-border); */
    border-radius: var(--border-radius);
    padding: 8px;
    cursor: pointer;
    transition: all 0.0s ease-in-out;
    width: 180px; /* Задаем ширину, чтобы табы были одинаковыми */
}

/* --- 3. Выделение активного контрол-таба --- */
/* Подсвечиваем только заголовок, как вы и просили */
.channel-tab-button.active .channel-tab-title {
    border: var(--highlighted-button-border);
}

.channel-tab-button.active {
    background-color: var(--highlighted-button-background-color);
    background-color: var(--button-background-color);
    border: var(--highlighted-button-background-color);
    margin-bottom: -10px;
    border-radius: 0;
}



/* --- 4. Внутренняя структура контрол-таба --- */
.channel-tab-button .channel-tab-title {
    font-weight: bold;
    font-size: 1.1em;
    padding: 5px;
    margin: -8px -8px 8px -8px; /* Выносим заголовок к краям */
    border-top-left-radius: var(--border-radius);
    border-top-right-radius: var(--border-radius);
    text-align: center;
    border: var(--button-border); /* Рамка по умолчанию */
    border-bottom: var(--box-border); /* Нижняя рамка-разделитель */
    transition: all 0.1s ease-in-out;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;

}

/* Вертикальное расположение контролов */
.channel-tab-button .channel-tab-controls {
    display: flex;
    flex-direction: column; /* Располагаем вертикально */
    gap: 6px;
    align-items: center; /* Центрируем по горизонтали */
}

/* Ограничиваем ширину инпутов */
.channel-tab-controls .setting {
    width: 160px;
}
.channel-tab-controls .setting .setting-label {
    width: 50%;
}

.channel-tab-controls .setting-input {
    width: 50%; /* Инпут занимает всю ширину родителя .setting */
}

.channel-tab-button .channel-tab-buttons {
    display: flex;
    justify-content: center;
    gap: 10px;
    width: 100%;
}
.channel-tab-button .channel-tab-buttons .button.button-with-icon {
    width: 50%;
    scale: 0.7;
}

/* --- 5. Общий контейнер для настроек канала (нижний блок) --- */
/* Используем Grid Layout для создания двух колонок */
.channel-details-grid {
    display: grid;
    /* Левая колонка - 350px, правая - всё остальное доступное место */
    grid-template-columns: 480px 1fr;
    gap: 20px;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    background-color: #17212b;
    padding: 20px;
}

/* --- 6. Стили для блока кроссовера (левая колонка) --- */
.crossover-block {
    /* Этот блок теперь просто контейнер, основная верстка в таблице */
}

.crossover-table {
    width: 100%;
    border-collapse: collapse;
}
.crossover-table th, .crossover-table td {
    border: var(--box-border);
    padding: 8px;
    text-align: center;
    vertical-align: middle;
}
.crossover-table th { background-color: var(--button-background-color); }
.input-with-button { display: flex; align-items: center; justify-content: center; gap: 8px; }
.crossover-table .setting { margin: 0; }
.crossover-table .setting-label { display: none; }

/* --- 7. Стили для ряда дополнительных фильтров (правая колонка) --- */
.additional-filters-wrapper .box-title { /* Стили для заголовка "Дополнительные фильтры" */
    font-weight: bold;
    margin-bottom: 10px;
}

/* ИСПРАВЛЕНО: Основной контейнер с фильтрами, теперь с переносом */
.additional-filters-row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap; /* <-- ВКЛЮЧАЕМ PЕРЕНОС */
    gap: 25px;
    padding: 5px; /* Уменьшаем паддинг, рамку убираем для чистоты */
    align-content: flex-start; /* Прижимаем строки к верху */
    width: 100%; /* <-- УКАЗЫВАЕМ, ЧТОБЫ БЛОК РАСТЯНУЛСЯ */
}


.additional-filters-row .box {
border-radius: var(--border-radius);
border: 10px solid var(--background-color);
min-width: 255px;
}

/* Контейнер для одного дополнительного фильтра, ограничиваем ширину */
.additional-filter-item {
    flex-shrink: 0;
    width: 220px; /* Максимальная ширина одного блока фильтра */
}

/* Уменьшаем инпуты внутри доп. фильтров, чтобы они влезали */
.additional-filter-item .setting-input {
    width: 100%; /* Занимает всю доступную ширину внутри .setting */
}
.additional-filter-item .setting-label {
    width: 40%; /* Уменьшаем долю лейбла, чтобы инпуту было больше места */
}

/* --- 8. Состояние Muted --- */
/* Этот класс нужно будет динамически добавлять к .channel-details-grid или .tabpanel */
.channel-muted {
  /*  filter: grayscale(100%); /* Делаем Ч/Б */
    opacity: 0.5; /* Делаем полупрозрачным */
    transition: all 0.1s;
}


/* ===== Стили для отображения единиц измерения в полях ввода ===== */

/* 1. Контейнер-обертка */
.input-with-unit {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%; /* Занимает всю доступную ширину в .setting */
}

/* 2. Стилизуем сам input внутри обертки */
.input-with-unit input {
    width: 100%;

}

/* 3. Стилизуем текст единиц измерения */
.input-unit {
    position: absolute;
    right: 8px; /* Располагаем справа с небольшим отступом */
    color: var(--disabled-text-color); /* Делаем текст приглушенным */
