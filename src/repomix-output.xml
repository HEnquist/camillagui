                  devices.capture.signal.level = level
                }
              })
            }
          />
        </>
      )}
      <LabelListOption
        value={capture.labels ? capture.labels.map((lab) => (lab ? lab : "")).join(",") : ""}
        error={errors.messageFor("labels")}
