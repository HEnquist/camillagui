            onChange={(loopback) =>
              onChange((devices) => {
                if (devices.capture.type === "Wasapi") {
                  devices.capture.loopback = loopback
                }
              })
            }
          />
        </>
      )}
      {(capture.type === "RawFile" || capture.type === "WavFile") && (
        <TextOption
          value={capture.filename}
          error={errors.messageFor("filename")}
          desc="filename"
          tooltip="Filename including path"
