  save_config_automatically: boolean
  status_update_interval: number
  can_update_active_config: boolean
  custom_shortcuts: ShortcutSection[]
  volume_max: number
  volume_range: number
  page_title: string
}

export type CaptureType =
  | "Alsa"
  | "Asio"
  | "Wasapi"
  | "Jack"
  | "CoreAudio"
  | "Pulse"
  | "PipeWire"
  | "RawFile"
  | "WavFile"
  | "Stdin"
  | "Bluez"
  | "SignalGenerator"

export type PlaybackType = "Alsa" | "Asio" | "Wasapi" | "Jack" | "CoreAudio" | "Pulse" | "PipeWire" | "File" | "Stdout"

export interface ShortcutSection {
  section: string
  description?: string
