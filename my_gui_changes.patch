+    height: fit-content;
+}
+.crossover-column-header {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    font-weight: bold;
+    margin-bottom: 5px;
+}
+/* Стили для байпаса (вы можете их кастомизировать) */
+.filter-bypassed {
+    opacity: 0.5;
+    background-color: #333;
+}
